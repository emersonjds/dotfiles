# ~/.zprofile — managed by dotfiles (copied, not symlinked).
# Login-shell only. The rest of the environment lives in ~/.config/shell/env.sh.

# Where Homebrew lives is decided in one file, shared with env.sh and ~/.bashrc.
_shell_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/shell"
[ -r "$_shell_config_dir/brew.sh" ] && . "$_shell_config_dir/brew.sh"
unset _shell_config_dir
